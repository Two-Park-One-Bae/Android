<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
        처치 타이머 (NM-441).

        spec §만료·알람이 "앱을 완전히 종료한 상태에서도 만료 시각에 알린다"를 타이머의
        최소 요건으로 못박았다. 그걸 지키려면 아래가 모두 필요하다.

        ⚠️ USE_EXACT_ALARM 은 선언하지 않는다 — 자동 허용이라 편하지만 Play 정책상
        알람·시계·캘린더가 주 기능인 앱만 쓸 수 있다. 널스메이트는 알약 식별이 함께 있어
        심사에서 다툴 여지가 있다. 대신 SCHEDULE_EXACT_ALARM 을 쓰고 사용자에게 설정을
        안내한다(권한이 없으면 예약을 건너뛰고 화면이 안내한다).
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 잠금화면 알람. Android 14+ 는 기본 거부라 없으면 헤드업으로 낮춰 표시된다. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 재부팅하면 AlarmManager 예약이 전부 사라진다 — 다시 걸어야 한다. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 카메라가 없는 기기(태블릿 일부)에서도 갤러리 선택으로 쓸 수 있으므로 required=false. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:name=".NurseMateApplication"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="널스메이트"
        android:theme="@style/Theme.NurseMate"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.NurseMate.Splash"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            카카오 로그인 리디렉션 — 카카오톡 앱(또는 계정 웹뷰)에서 돌아올 경로다.
            스킴은 `kakao{네이티브앱키}` 로 고정이라 빌드 타입마다 다르다.
            ${kakaoScheme} 는 app/build.gradle.kts 의 kakaoAppKey() 가 채운다.

            액티비티는 SDK 가 제공하는 것을 그대로 쓴다 — 우리가 구현할 게 없다.
        -->
        <activity
            android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="oauth"
                    android:scheme="${kakaoScheme}" />
            </intent-filter>
        </activity>

        <!--
          결과 PDF 를 다른 앱에 넘기는 통로. file:// 를 그대로 주면 FileUriExposedException 이다.
          authorities 에 applicationId 를 쓴다 — 디버그(.debug)와 릴리스가 같은 기기에
          함께 설치돼도 부딪히지 않아야 한다.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/nm_share_paths" />
        </provider>


        <!-- 처치 타이머 알람 (NM-441). 앱 밖에서 깨어나므로 exported=false 로 둔다. -->
        <receiver
            android:name="app.nursemate.timer.alarm.TimerAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name="app.nursemate.timer.alarm.TimerBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
