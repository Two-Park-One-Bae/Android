<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
        광고 ID 를 쓰지 않는다 (NM-466).

        `firebase-analytics` 가 `AD_ID` 권한을 **자동으로 병합**한다. 우리가 선언한 적은 없지만
        병합된 매니페스트에는 들어가고, Android 13+ 대상 앱이 이 권한을 가지면 Play 가
        「광고 ID 선언」을 요구하며 **검토 전송 자체를 막는다**(실제로 0.2.2 에서 막혔다).

        ⚠️ 선언으로 넘기지 않고 권한을 빼는 쪽을 골랐다. 개인정보처리방침 3항이
        「광고 식별자(IDFA) 및 광고·추적 목적의 데이터를 수집하지 않는다」고 못박았고,
        데이터 보안 신고에서도 「기기 또는 기타 ID」를 선택하지 않았다 — 권한만 남겨 두면
        공개한 약속과 실제가 어긋난다.

        Analytics 는 광고 ID 없이도 동작한다(앱 인스턴스 ID 로 센다). 광고를 붙이게 되면
        이 줄을 지우고 방침·데이터 보안 신고를 함께 고쳐야 한다.
    -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <!--
        Privacy Sandbox 의 광고 권한도 같이 뺀다. `firebase-analytics` 가 함께 병합하는데,
        Play 의 광고 ID 선언은 위 `gms.permission.AD_ID` 로 판단하므로 이것만으로는 막히지
        않는다. 그래도 남겨 두면 **스토어에 광고 관련 권한이 보인다** — 광고를 쓰지 않는다고
        공개한 앱에서 설명할 수 없는 자리다.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />

    <!--
        처치 타이머 (NM-441).

        spec §만료·알람이 "앱을 완전히 종료한 상태에서도 만료 시각에 알린다"를 타이머의
        최소 요건으로 못박았다. 그걸 지키려면 아래가 모두 필요하다.

        ⚠️ USE_EXACT_ALARM 은 선언하지 않는다 — 자동 허용이라 편하지만 Play 정책상
        알람·시계·캘린더가 주 기능인 앱만 쓸 수 있다. 널스메이트는 알약 식별이 함께 있어
        심사에서 다툴 여지가 있다. 대신 SCHEDULE_EXACT_ALARM 을 쓰고 사용자에게 설정을
        안내한다(권한이 없으면 예약을 건너뛰고 화면이 안내한다).
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 만료 진동. 없으면 알림은 뜨는데 진동만 조용히 빠진다 — 폰에만 없었다. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
      만료가 울리는 동안 도는 포그라운드 서비스 (TimerAlarmService).

      알림 채널의 소리·진동은 링어 모드에 걸려 무음에서 통째로 막히는데, spec §만료·알람은
      "기기 무음과 무관하게"를 요구한다. 그래서 앱이 알람 스트림으로 직접 내고, 그러려면
      프로세스가 살아 있어야 한다. 워치와 같은 구조다.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 잠금화면 알람. Android 14+ 는 기본 거부라 없으면 헤드업으로 낮춰 표시된다. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 재부팅하면 AlarmManager 예약이 전부 사라진다 — 다시 걸어야 한다. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 카메라가 없는 기기(태블릿 일부)에서도 갤러리 선택으로 쓸 수 있으므로 required=false. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:name=".NurseMateApplication"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/nm_app_name"
        android:theme="@style/Theme.NurseMate"
        android:supportsRtl="true">

        <!--
            잠금화면을 덮는 만료 알람 (NM-442).

            ⚠️ **`showWhenLocked` 가 핵심이다.** 예전에는 풀스크린 인텐트로 `MainActivity` 를
            넘겼는데 그 액티비티에는 이 속성이 없어, 시스템이 조용히 헤드업으로 낮추고
            잠금화면에는 아무것도 안 띄웠다(실기기 확인).

            `excludeFromRecents` — 알람은 최근 목록에 남을 일이 아니다.
            `singleTask` — 여러 개가 동시에 만료해도 화면은 하나다.
        -->
        <activity
            android:name=".timer.alarm.TimerAlarmActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.NurseMate" />

        <!--
            ⚠️ `adjustResize` 를 **명시**한다.

            이 앱은 edge-to-edge 라(`enableEdgeToEdge`) 키보드 높이를 `WindowInsets.ime` 로 받아
            화면이 직접 패딩한다. 그런데 모드를 안 적어 두면 시스템이 `adjustPan` 을 고를 수 있고,
            그러면 **창이 통째로 위로 밀린 채 패딩까지 들어가** 위가 잘리고 아래가 빈다.
            각인 입력 줄(NM-516)을 LazyColumn 밖 하단에 두면서 실제로 그 모양이 나왔다.
        -->
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.NurseMate.Splash"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            카카오 로그인 리디렉션 — 카카오톡 앱(또는 계정 웹뷰)에서 돌아올 경로다.
            스킴은 `kakao{네이티브앱키}` 로 고정이라 빌드 타입마다 다르다.
            ${kakaoScheme} 는 app/build.gradle.kts 의 kakaoAppKey() 가 채운다.

            액티비티는 SDK 가 제공하는 것을 그대로 쓴다 — 우리가 구현할 게 없다.
        -->
        <activity
            android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="oauth"
                    android:scheme="${kakaoScheme}" />
            </intent-filter>
        </activity>

        <!--
          결과 PDF 를 다른 앱에 넘기는 통로. file:// 를 그대로 주면 FileUriExposedException 이다.
          authorities 에 applicationId 를 쓴다 — 디버그(.debug)와 릴리스가 같은 기기에
          함께 설치돼도 부딪히지 않아야 한다.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/nm_share_paths" />
        </provider>


        <!-- 처치 타이머 알람 (NM-441). 앱 밖에서 깨어나므로 exported=false 로 둔다. -->
        <receiver
            android:name="app.nursemate.timer.alarm.TimerAlarmReceiver"
            android:exported="false" />

        <!--
            만료가 울리는 동안만 도는 서비스 (NM-441).

            `specialUse` — 정해진 유형 중 맞는 것이 없다. `mediaPlayback` 은 사용자가 고른
            콘텐츠 재생용이고 이건 알람음이며, Android 는 알람용 포그라운드 유형을 두지 않았다.
        -->
        <service
            android:name="app.nursemate.timer.alarm.TimerAlarmService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="처치 타이머 만료 알림 — [완료] 를 누를 때까지 알람음·진동을 이어 준다" />
        </service>

        <!--
            지정 프리셋 위젯 (NM-443).

            ⚠️ **exported=true 여야 한다.** 위젯 갱신 브로드캐스트를 보내는 쪽은 시스템·런처라,
            내보내지 않으면 위젯이 목록에 뜨지도 갱신되지도 않는다. 받는 인텐트는 AppWidget
            프레임워크 것뿐이고 우리 데이터를 꺼내 가는 통로가 아니다.
        -->
        <receiver
            android:name="app.nursemate.timer.widget.PresetWidgetReceiver"
            android:label="@string/nm_preset_widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- 위젯 탭 — 앱을 열지 않고 바로 시작한다. -->
                <action android:name="app.nursemate.timer.widget.START" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nm_preset_widget_info" />
        </receiver>

        <!--
            슬롯 지정 화면. 런처가 위젯을 놓는 순간 띄우므로 exported 여야 한다.
            excludeFromRecents — 설정 한 번 하고 끝나는 화면이라 최근 목록에 남을 이유가 없다.

            ⚠️ **taskAffinity 를 비워 자기 태스크에서 돌린다.** 안 그러면 앱 태스크에 얹히는데,
            지정을 마치고 이 화면이 닫히면 **밑에 있던 MainActivity 가 드러난다** — 홈 화면에서
            위젯을 만졌는데 앱 홈이 뜬다(실기기에서 확인). 자기 태스크면 닫히는 즉시 런처로 돌아간다.
        -->
        <activity
            android:name="app.nursemate.timer.widget.PresetWidgetConfigActivity"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>


        <!-- 워치가 내놓은 타이머 복제본을 받는다 (NM-445). -->
        <service
            android:name="app.nursemate.timer.sync.TimerReplicaListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/nursemate/timer/replica"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!--
            ⚠️ ONNX Runtime 1.30 의 텔레메트리를 **끈다** (NM-534).

            AAR 이 `ai.onnxruntime.TelemetryInitializer` 를 ContentProvider 로 선언한다.
            ContentProvider 는 `Application.onCreate` 보다 먼저 자동으로 돌아서, **우리 코드가
            ONNX 를 부르지 않아도 앱을 켜는 순간 실행된다.** 딸려 있는 클래스가 `HttpClient` ·
            `ConnectivityCallback` · `PowerInfoReceiver` 라 기기 정보를 모아 밖으로 보낸다.

            간호 기록을 다루는 앱이라 우리가 신고하지 않은 수집 경로를 둘 수 없다 —
            Play 데이터 보안 신고와 개인정보처리방침이 모두 어긋난다.

            `tools:ignore="MissingClass"` 가 필요하다 — onnxruntime 은 `core:vision` 의
            `implementation` 이라 app 모듈 클래스패스에 없고, lint 가 지우려는 클래스를 못 찾는다.

            AAR 이 함께 선언하는 `ACCESS_NETWORK_STATE` 는 **빼지 않는다** — Firebase Analytics 가
            같은 권한을 요구한다(lint `MissingPermission`). 텔레메트리만 막으면 된다.

            ORT 1.22 에는 없던 것이다. **버전을 올릴 때마다 병합 매니페스트를 다시 본다**
            (`app/build/intermediates/merged_manifest/release/.../AndroidManifest.xml`).
        -->
        <provider
            android:name="ai.onnxruntime.TelemetryInitializer"
            android:authorities="${applicationId}.onnxruntime_telemetry_initializer"
            tools:node="remove"
            tools:ignore="MissingClass" />

    </application>
</manifest>
