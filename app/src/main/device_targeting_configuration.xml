<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ **어느 기기에 어느 QNN 모듈을 내려줄지.**
  ~
  ~ 그룹 하나 = Hexagon 세대 하나 = feature module 하나(`qnn_v73` 등). 기기는 자기 세대
  ~ 모듈만 받는다 — 한 그룹에 다 몰면 안 쓰는 세대 Skel 을 19MB 씩 더 받는다.
  ~ 세대와 무관한 토대(`qnn_core`)는 아래 그룹 **전부**에 걸려 있다.
  ~
  ~ `manufacturer`/`model` 은 `Build.SOC_MANUFACTURER`/`Build.SOC_MODEL` 그대로다.
  ~
  ~ ## 못 알아본 기기는 어떻게 되나
  ~ 어느 그룹에도 안 맞으면 자동으로 "other" 로 떨어져 **base 만** 설치된다. 앱은 원본 ONNX 를
  ~ WebGpuPolicy 가 고른 EP(WebGPU 또는 CPU)로 연다 — 느릴 뿐 **깨지지 않는다.**
  ~ 새 칩이 나왔을 때의 기본 동작이 이것이고, 일부러 이렇게 뒀다.
  ~
  ~ ⚠️ **SoC 조건은 API 31+ 이다.** 폰 minSdk 가 26 이라 그 아래는 그룹에 안 맞는데,
  ~    어차피 QNN 이 안 되는 기기들이라 맞는 동작이다.
  ~
  ~ ## 세대 매핑 근거
  ~ Qualcomm AI Hub 기기 목록의 `hexagon:` 속성이다(2026-10-14 조회). 추측이 아니다.
  ~ `scripts/qnn_chipsets.py` 가 그 목록을 다시 뽑아 이 파일과 대조한다.
  ~
  ~ **V85(SM8950 · SM8975, 8 Elite Gen 6)는 일부러 뺐다** — `qnn-runtime` 2.51 에 그 세대
  ~ Skel 이 없다. 그룹에 넣으면 토대만 받고 Skel 이 없어 QNN 이 안 뜬다. SDK 를 올려 Skel 이
  ~ 생기면 그때 모듈과 그룹을 함께 더한다.
  -->
<config:device-targeting-config
    xmlns:config="http://schemas.android.com/apk/config">

    <!-- Hexagon V73 · Snapdragon 8 Gen 2 — Galaxy S23 · Z Fold5.
         DeviceProbeTest 가 dm1q(SM-S911U)에서 QTI/SM8550 을 직접 찍었다. -->
    <config:device-group name="qti_v73">
        <config:device-selector>
            <config:system-on-chip manufacturer="QTI" model="SM8550"/>
        </config:device-selector>
        <!-- 같은 V73 · 7 Gen 3. 실기기 미확인이라 틀렸으면 other 로 떨어질 뿐이다. -->
        <config:device-selector>
            <config:system-on-chip manufacturer="QTI" model="SM7750"/>
        </config:device-selector>
    </config:device-group>

    <!-- Hexagon V75 · Snapdragon 8 Gen 3 — Galaxy S24.
         DeviceProbeTest 가 e1q 에서 QTI/SM8650 을 직접 찍었다. -->
    <config:device-group name="qti_v75">
        <config:device-selector>
            <config:system-on-chip manufacturer="QTI" model="SM8650"/>
        </config:device-selector>
    </config:device-group>

    <!-- Hexagon V79 · Snapdragon 8 Elite — Galaxy S25.
         ⚠️ AI Hub 는 칩셋을 `sm8750-ac` 로 적는다. `Build.SOC_MODEL` 이 접미사를 달고 오는지
            실기기로 확인하지 못해 **둘 다** 적는다. 안 맞는 쪽은 아무 기기와도 안 맞을 뿐이다. -->
    <config:device-group name="qti_v79">
        <config:device-selector>
            <config:system-on-chip manufacturer="QTI" model="SM8750"/>
        </config:device-selector>
        <config:device-selector>
            <config:system-on-chip manufacturer="QTI" model="SM8750-AC"/>
        </config:device-selector>
    </config:device-group>

    <!-- Hexagon V81 · Snapdragon 8 Elite Gen 5 — Galaxy S26. 지금 팔리는 플래그십이다.
         ⚠️ V79 와 같은 이유로 접미사 유무 둘 다 적는다. -->
    <config:device-group name="qti_v81">
        <config:device-selector>
            <config:system-on-chip manufacturer="QTI" model="SM8850"/>
        </config:device-selector>
        <config:device-selector>
            <config:system-on-chip manufacturer="QTI" model="SM8850-AD"/>
        </config:device-selector>
    </config:device-group>
</config:device-targeting-config>
