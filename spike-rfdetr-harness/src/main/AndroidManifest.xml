<?xml version="1.0" encoding="utf-8"?>
<!--
  NM-396 스파이크 PoC.
  카메라는 시스템 카메라 앱(ACTION_IMAGE_CAPTURE)으로 위임하므로 CAMERA 권한이 필요 없다.
  갤러리는 Photo Picker(PickVisualMedia)를 쓰므로 저장소 권한도 필요 없다.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="RF-DETR PoC"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:supportsRtl="true">

        <activity
            android:name=".PocActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 시스템 카메라 앱에 촬영 결과 저장 위치를 넘기려면 FileProvider가 필요하다 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
