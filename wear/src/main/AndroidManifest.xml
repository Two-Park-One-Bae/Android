<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".NurseMateWearApplication"
        android:label="널스메이트"
        android:theme="@android:style/Theme.DeviceDefault"
        android:supportsRtl="true">

        <!-- 하이브리드: 폰 없이도 핵심 기능(타이머) 동작 -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            폰이 보낸 스냅샷을 받는다 (NM-445). 앱이 꺼져 있어도 시스템이 깨워 전달한다.
            보내는 쪽이 Google Play 서비스라 exported 여야 한다.
        -->
        <service
            android:name=".sync.TimerSnapshotListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/nursemate/timer/snapshot"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>
</manifest>
