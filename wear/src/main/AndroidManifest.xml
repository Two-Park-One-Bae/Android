<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        만료를 손목에 알린다 (NM-444).

        ⚠️ **워치가 직접 띄워야 한다.** 같은 패키지의 워치 앱이 깔리면 시스템이 폰 알림
        브리징을 끊는다 — 워치가 안 띄우면 아무 일도 일어나지 않는다(실기기 확인).
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
        만료가 울리는 동안만 도는 서비스 (NM-444).

        ⚠️ **specialUse 다.** Android 14+ 는 포그라운드 서비스에 유형을 요구하는데 알람에
        맞는 유형이 없다. 진동을 [완료] 까지 이어 주는 것이 목적이라 아래에 사유를 적어 둔다.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".NurseMateWearApplication"
        android:label="널스메이트"
        android:theme="@android:style/Theme.DeviceDefault"
        android:supportsRtl="true">

        <!-- 하이브리드: 폰 없이도 핵심 기능(타이머) 동작 -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            폰이 보낸 스냅샷을 받는다 (NM-445). 앱이 꺼져 있어도 시스템이 깨워 전달한다.
            보내는 쪽이 Google Play 서비스라 exported 여야 한다.
        -->
        <service
            android:name=".sync.TimerSnapshotListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/nursemate/timer/snapshot"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <service
            android:name=".alarm.WearAlarmService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="처치 타이머 만료 알림 — [완료] 를 누를 때까지 손목에 진동을 이어 준다" />
        </service>

        <!--
            워치 페이스에서 위로 쓸어 올리면 나오는 프리셋 시작 타일 (NM-445).

            런처가 우리 대신 그리므로 exported 여야 하고, 아무나 붙지 못하도록
            BIND_TILE_PROVIDER 권한을 요구한다(시스템 런처만 가진 권한이다).
        -->
        <service
            android:name=".tile.PresetTileService"
            android:label="널스메이트 타이머"
            android:exported="true"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview" />
        </service>

        <!-- 워치 알림의 [완료]. 시스템이 보내므로 내보낼 필요는 없다. -->
        <receiver
            android:name=".alarm.WearTimerActionReceiver"
            android:exported="false" />
    </application>
</manifest>
