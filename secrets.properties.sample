# 로컬 개발용 시크릿 — 이 파일을 secrets.properties 로 복사한 뒤 실제 값을 채운다. (secrets.properties는 gitignored)
# CI에서는 GitHub Secrets로 생성된다 — PR CI: BASE_URL_DEV/BASE_URL_PROD · 릴리스 CI: RELEASE_* 추가
BASE_URL_DEBUG=https://your-dev-api.example.com
BASE_URL_RELEASE=https://your-prod-api.example.com

# 릴리스 서명 (선택) — keystore·비밀번호는 certificates 레포 android/ 참고.
# 아래 4개가 없으면 release 빌드는 미서명으로 산출된다 (개발 중엔 없어도 됨).
RELEASE_STORE_FILE=../certificates/android/nursemate-upload.jks
RELEASE_STORE_PASSWORD=change-me
RELEASE_KEY_ALIAS=nursemate-upload
RELEASE_KEY_PASSWORD=change-me
