<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Hexagon **V81** 전용 — Snapdragon 8 Elite Gen 5 (SM8850). Galaxy S26.
  ~
  ~ 설치 시점 조건부 전달. Play 가 `qti_v81` 기기그룹에 맞는 기기에만 설치한다.
  ~ 그룹 정의는 app/src/main/device_targeting_configuration.xml 이다.
  -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:dist="http://schemas.android.com/apk/distribution">

    <dist:module dist:instant="false" dist:title="@string/qnn_module_title">
        <dist:delivery>
            <dist:install-time>
                <dist:conditions>
                    <dist:device-groups>
                        <dist:device-group dist:name="qti_v81" />
                    </dist:device-groups>
                </dist:conditions>
            </dist:install-time>
        </dist:delivery>
        <dist:fusing dist:include="true" />
    </dist:module>

    <!-- 코드 없음 — 까닭은 QnnFeatureConventionPlugin KDoc 「세대 모듈은 hasCode="false" 다」. -->
    <application android:hasCode="false" />
</manifest>
